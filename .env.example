CSAC_RELEASE=local
CSAC_DB_PASSWORD=replace-with-a-random-password
CSAC_CACHE_SALT=replace-with-a-random-secret
CSAC_BOT_SECRET=replace-with-a-random-secret
CSAC_ACOP_SECRET=replace-with-a-random-secret
CSAC_ADMIN_UID=1
CSAC_DATA_ROOT=/opt/1panel/www/sites/csac/data
# Disable only when deploying without SMTP intentionally.
CSAC_REQUIRE_EMAIL_VERIFICATION=true

# Android/Web WebSocket v2
CSAC_WS_ORIGINS=https://csac.chat
CSAC_WS_RETENTION_DAYS=7
CSAC_WS_MAX_CONNECTIONS=256
