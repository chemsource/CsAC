CSAC_RELEASE=local
CSAC_DB_PASSWORD=replace-with-a-random-password
CSAC_CACHE_SALT=replace-with-a-random-secret
CSAC_BOT_SECRET=replace-with-a-random-secret
CSAC_ACOP_SECRET=replace-with-a-random-secret
CSAC_ADMIN_UID=1
CSAC_DATA_ROOT=/opt/1panel/www/sites/csac/data
# The two optional overrides can set registration and existing-account policy separately.
CSAC_REQUIRE_EMAIL_VERIFICATION=true
# CSAC_REQUIRE_REGISTER_EMAIL_VERIFICATION=true
# CSAC_REQUIRE_EXISTING_USER_EMAIL_VERIFICATION=true

# SMTP credentials belong only in the server's private .env file.
CSAC_SMTP_HOST=
CSAC_SMTP_PORT=465
CSAC_SMTP_SECURE=ssl
CSAC_SMTP_USERNAME=
CSAC_SMTP_PASSWORD=
CSAC_SMTP_FROM_EMAIL=
CSAC_SMTP_FROM_NAME=CsAC
ACOP_SMTP_HOST=
ACOP_SMTP_PORT=465
ACOP_SMTP_USER=
ACOP_SMTP_PASS=
ACOP_SMTP_FROM=
EMAPPS_MAX_PKG_SIZE=2097152

# Android/Web WebSocket v2
CSAC_WS_ORIGINS=https://csac.chat
CSAC_WS_RETENTION_DAYS=7
CSAC_WS_MAX_CONNECTIONS=256
