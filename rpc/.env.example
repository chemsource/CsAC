# CsAC 后端配置文件
# 复制此文件为 .env 并修改为你的实际配置
# .env 文件应放置在与可执行文件相同的目录下

# ---- 必填配置 ----

# 数据库配置
CSAC_DB_HOST=localhost
CSAC_DB_USER=root
CSAC_DB_PASS=your_db_password
CSAC_DB_NAME=csac

# 缓存盐值（用于session加密，请修改为随机字符串）
CSAC_CACHE_SALT=please_change_this_to_a_random_string

# ---- SMTP 邮件配置（如需邮箱验证功能则必填）----

CSAC_SMTP_HOST=smtp.example.com
CSAC_SMTP_PORT=465
CSAC_SMTP_SECURE=ssl
CSAC_SMTP_USERNAME=your_email@example.com
CSAC_SMTP_PASSWORD=your_smtp_password
CSAC_SMTP_FROM_EMAIL=your_email@example.com
CSAC_SMTP_FROM_NAME=CsAC

# ---- 可选配置（以下为默认值，如需修改请取消注释）----

# 监听地址
# CSAC_HTTP_ADDR=:8080

# 管理员用户ID
# CSAC_ADMIN_UID=1

# Session 有效期（秒，默认30天）
# CSAC_SESSION_LIFETIME_SECONDS=2592000

# 长轮询最大等待秒数
# CSAC_LONG_POLL_MAX_SECONDS=15

# 长轮询休眠毫秒数
# CSAC_LONG_POLL_SLEEP_MILLIS=350

# 图片最大字节数（默认5MB）
# CSAC_MAX_IMAGE_BYTES=5242880

# 语音最大字节数（默认10MB）
# CSAC_MAX_VOICE_BYTES=10485760

# 默认头像文件名
# CSAC_DEFAULT_AVATAR=default.png

# 是否要求注册时验证邮箱（默认开启）
# CSAC_REQUIRE_REGISTER_EMAIL_VERIFICATION=true

# 是否要求已有用户验证邮箱（默认开启）
# CSAC_REQUIRE_EXISTING_USER_EMAIL_VERIFICATION=true

# 上传目录
# CSAC_UPLOAD_DIR=upload

# 私有上传目录
# CSAC_PRIVATE_UPLOAD_DIR=uploads/chat

# Session Cookie 名称
# CSAC_SESSION_COOKIE_NAME=PHPSESSID

# 管理员名称（显示在欢迎通知中，默认 Admin）
# CSAC_ADMIN_NAME=Admin

# v2.2.0: ServerBot事件转发配置（留空则禁用事件转发）
# CSAC_BOT_ENDPOINT=http://serverbot:8081/bot/internal/event
# CSAC_BOT_SECRET=change_me_bot_secret

# v2.2.0-r2: 自动更新（默认关闭，开启后后端将自动检查GitHub Release并下载更新）
# CSAC_AUTO_UPDATE=false

# v2.2.0-r2: Web前端解压目录（默认为上级目录，即web zip直接解压到该目录）
# CSAC_WEB_DIR=/www/sites/csac.chat/index

# v2.2.0-r2: 更新文件下载目录（默认为上级目录下的update/）
# CSAC_UPDATE_DIR=/www/sites/csac.chat/index/update

# v2.3.0: 文件消息配置
# 允许的文件扩展名（逗号分隔）
# CSAC_FILE_ALLOWED_TYPES=txt,doc,docx,xls,xlsx,ppt,pptx,pdf,rtf,html,css,acr,acrg,jar,cpp,c,h,hpp,java,py,dart,js,ts,go,rs,rb,php,swift,kt,sh,bat,ps1,sql,json,xml,yaml,yml,md,csv,log,ini,cfg,conf,toml
# 文件最大字节数（默认2KB）
# CSAC_FILE_MAX_BYTES=2048
# 文件过期天数（默认3天）
# CSAC_FILE_EXPIRE_DAYS=3
