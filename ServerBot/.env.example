# ServerBot 配置文件
# 复制此文件为 .env 并修改为你的实际配置
# .env 文件应放置在与可执行文件相同的目录下

# ---- 必填配置 ----

# 数据库配置（与主服务器使用同一数据库）
SB_DB_HOST=localhost
SB_DB_USER=root
SB_DB_PASS=your_db_password
SB_DB_NAME=csac

# 内部通信密钥（必须与主服务器 CSAC_BOT_SECRET 一致）
SB_SECRET=change-me-to-a-random-secret

# ---- 可选配置（以下为默认值，如需修改请取消注释）----

# HTTP 监听地址
# SB_HTTP_ADDR=:8081

# WebSocket 路径
# SB_WS_PATH=/bot/ws

# API 速率限制（每秒请求数）
# SB_RATE_LIMIT_PER_SEC=5

# v2.2.1: 是否允许Bot脚本导入第三方库（默认关闭，开启后允许 import(url) 导入外部库）
# SB_ALLOW_TPARTY_LIB=0
