# CsAC 开放平台 (ACOP) 配置文件
# 复制此文件为 .env 并修改为你的实际配置
# .env 文件应放置在与可执行文件相同的目录下

# ---- 必填配置 ----

# 数据库配置（与主服务器使用同一数据库）
ACOP_DB_HOST=localhost
ACOP_DB_USER=root
ACOP_DB_PASS=your_db_password
ACOP_DB_NAME=csac

# Session 密钥（请修改为随机字符串）
ACOP_SECRET=change-me-to-a-random-secret

# ServerBot 内部通信端点（也可用 ACOP_BOTAPI_URL，优先使用）
ACOP_BOT_ENDPOINT=http://serverbot:8081

# ServerBot 内部通信密钥（必须与 ServerBot 的 SB_SECRET 一致）
ACOP_BOT_SECRET=change-me-to-a-random-secret

# ---- SMTP 邮件配置（如需邮箱验证码功能则必填）----

# SMTP 服务器地址
ACOP_SMTP_HOST=smtp.example.com

# SMTP 端口（465=SSL, 587=STARTTLS）
ACOP_SMTP_PORT=465

# SMTP 用户名
ACOP_SMTP_USER=your_email@example.com

# SMTP 密码或授权码
ACOP_SMTP_PASS=your_smtp_password

# 发件人地址（默认同 ACOP_SMTP_USER）
ACOP_SMTP_FROM=your_email@example.com

# ---- 可选配置（以下为默认值，如需修改请取消注释）----

# HTTP 监听地址
# ACOP_HTTP_ADDR=:8082

# 管理员用户ID
# ACOP_ADMIN_UID=1

# AJL库文件输出目录（默认：空 = 通过HTTP让ServerBot自保存，适合Docker部署）
# 同机部署（非容器）时设置此路径让ACOP直接写文件，例如：
# ACOP_LIB_DIR=/opt/csac/ServerBot/lib

